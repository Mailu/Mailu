#!/bin/sh
# script-login runs this after userdb lookup and before the mail process starts.
# The provisioner verifies the account against admin and uses safe directory fds.
# Dovecot clears the environment, so the mailbox ID range is passed explicitly.
[ -d "$HOME" ] || MAILBOX_UID_MIN={{ MAILBOX_UID_MIN }} MAILBOX_UID_MAX={{ MAILBOX_UID_MAX }} \
  /app/venv/bin/python /provision_mailbox.py '{{ ADMIN_ADDRESS }}' "$USER" || exit 1
exec "$@"
